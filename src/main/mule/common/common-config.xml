http://www.mulesoft.org/schema/mule/api-gateway http://www.mulesoft.org/schema/mule/api-gateway/current/mule-api-gateway.xsd">
	<db:config name="Database_Config" doc:name="Database Config" doc:id="83e13639-3853-4cb5-81f3-8a33da8e9281" >
		<db:generic-connection url="${database.url}" driverClassName="${database.driver}" user="${database.user}" password="${secure::database.password}" />
