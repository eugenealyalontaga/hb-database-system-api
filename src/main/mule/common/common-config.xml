	<configuration-properties doc:name="Configuration properties" doc:id="d6cfcc97-e7fa-4725-b9ef-7ccdc815816f" file="config\config-${mule.env}.yaml" />
	<secure-properties:config name="Secure_Properties_Config" doc:name="Secure Properties Config" doc:id="4c64b4fc-770f-4e3c-8c78-64a0a3b7c293" file="config\config-secured-${mule.env}.yaml" key="${secure.key}" />
	<global-property doc:name="Global Property" doc:id="1572454b-e290-4506-9d78-732ba1123eff" name="mule.env" value="local" />
	<global-property doc:name="Global Property" doc:id="e97f1177-a782-4459-9c67-92b92e9081de" name="secure.key" value="HeritageBookshop" />
	<api-gateway:autodiscovery apiId="${api.id}" ignoreBasePath="true" doc:name="API Autodiscovery" doc:id="d51d14b9-5c2f-4d1f-b419-d25e30f306b2" flowRef="hb-sales-system-api-main" />
